// Найдите функцию orderBurgerApi и добавьте console.log
export const orderBurgerApi = (data: string[]) => {
  console.log('orderBurgerApi called with data:', data);
  console.log('AccessToken from cookie:', getCookie('accessToken'));
  return fetchWithRefresh<TNewOrderResponse>(`${URL}/orders`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json;charset=utf-8',
      authorization: getCookie('accessToken')
    } as HeadersInit,
    body: JSON.stringify({
      ingredients: data
    })
  }).then((data) => {
    if (data?.success) return data;
    return Promise.reject(data);
  });
};
