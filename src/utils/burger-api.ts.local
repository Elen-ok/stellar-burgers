// Временно замените в файле burger-api.ts функцию orderBurgerApi на эту версию
// Она не требует авторизации для теста

export const orderBurgerApi = (data: string[]) =>
  fetch(`${URL}/orders`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json;charset=utf-8'
    },
    body: JSON.stringify({
      ingredients: data
    })
  }).then((res) => checkResponse<TNewOrderResponse>(res));
